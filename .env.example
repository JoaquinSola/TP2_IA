# Copia este archivo a .env y completá los valores

# Google Gemini API Key (obtener en https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=tu_api_key_aqui

# Modelo principal (si da 503, el sistema cae automáticamente a gemini-2.5-flash-lite)
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Puerto del servidor backend
PORT=8000

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Directorio para guardar logs
LOG_DIR=logs
